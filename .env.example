# Non-secret local configuration. Copy to .env only for local tooling.
AWS_PROFILE=robot-platform
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-west-1
EKS_CLUSTER_NAME=robot-telemetry-cluster
S3_BUCKET_NAME=replace-with-globally-unique-bucket
ATHENA_DATABASE=robot_telemetry_db
ATHENA_WORKGROUP=robot-telemetry-workgroup
KINESIS_STREAM_NAME=robot-telemetry-stream
KINESIS_ALERT_STREAM_NAME=robot-anomaly-alert-stream

# Local scripts compare AWS_ACCOUNT_ID with `aws sts get-caller-identity`
# before any external mutation. CI derives the account ID from its OIDC session.
# IMAGE_TAG is the 40-character Git commit SHA.
# Slack, Grafana, and portal credentials belong in AWS Secrets Manager.
