          "format": 1,
          "rawSQL": "-- 이번 달 누적 = current month-to-date 의 AI 예측 합 × 120 만원\nSELECT COUNT(*) * 120 AS \"이번 달 누적 절감액\"\nFROM robot_telemetry_db.gold_robot_daily_stats\nWHERE dt >= date_trunc('month', CAST(current_timestamp AT TIME ZONE 'Asia/Seoul' AS DATE))\n  AND dt <  CAST(current_timestamp AT TIME ZONE 'Asia/Seoul' AS DATE)\n  AND dominant_failure_type IS NOT NULL\n  AND dominant_failure_type <> 'NONE'",
