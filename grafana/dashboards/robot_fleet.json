          "format": 1,
          "rawSQL": "SELECT robot_id AS \"로봇 ID\", ROUND(max_motor_temp, 1) AS \"최고 온도(°C)\", battery_drain AS \"배터리 소모\", anomaly_record_count AS \"이상치 발생\", ROUND(max_temp_load_ratio, 2) AS \"최대 부하율\", ROUND(max_motor_temp + COALESCE(anomaly_record_count, 0) * 0.05 + battery_drain * 0.3 + COALESCE(max_temp_load_ratio, 0) * 5, 1) AS \"위험도\" FROM robot_telemetry_db.gold_robot_daily_stats WHERE dt = CAST(CAST(current_timestamp AT TIME ZONE 'Asia/Seoul' AS DATE) - INTERVAL '1' DAY AS DATE) ORDER BY \"위험도\" DESC LIMIT 15",
          "refId": "A",
          "table": "gold_robot_daily_stats"
        }
      ],
