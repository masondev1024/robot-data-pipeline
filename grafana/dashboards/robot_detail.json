          "format": 0,
          "rawSQL": "SELECT DATE_TRUNC('minute', from_iso8601_timestamp(\"timestamp\")) AS time, AVG(motor_temp) AS \"평균 온도\", MAX(motor_temp) AS \"피크 온도\" FROM robot_telemetry_db.bronze_robot_telemetry WHERE robot_id = '${robot_id}' AND ((year = date_format(current_date - interval '1' day, '%Y') AND month = date_format(current_date - interval '1' day, '%m') AND day = date_format(current_date - interval '1' day, '%d')) OR (year = date_format(current_date, '%Y') AND month = date_format(current_date, '%m') AND day = date_format(current_date, '%d'))) AND from_iso8601_timestamp(\"timestamp\") > current_timestamp - INTERVAL '24' HOUR GROUP BY DATE_TRUNC('minute', from_iso8601_timestamp(\"timestamp\")) ORDER BY time ASC",
          "refId": "A",
          "table": "bronze_robot_telemetry"
        }
      ],
