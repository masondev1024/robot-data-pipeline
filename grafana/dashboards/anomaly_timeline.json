            "resultReuseEnabled": false,
            "resultReuseMaxAgeInMinutes": 60
          },
          "datasource": { "type": "grafana-athena-datasource", "uid": "athena" },
          "format": 0,
          "rawSQL": "-- ADR-009 Flink Z-Score(σ>3) + 다변량 룰 결과 (silver_alerts) — 시연용 분 단위 버킷\n-- §1.A Firehose buffer 300s → 최신 ~5분은 미적재. picker 30m+ 권장.\n-- WHERE 절은 $__timeFilter() 로 Grafana picker 와 연동.\nSELECT DATE_TRUNC('minute', date_parse(window_end, '%Y-%m-%d %H:%i:%s')) AS event_minute,\n       COUNT(*) AS alert_count,\n       COUNT(DISTINCT robot_id) AS distinct_robots\nFROM robot_telemetry_db.silver_alerts\nWHERE ((year = date_format(current_date - INTERVAL '1' DAY, '%Y')\n        AND month = date_format(current_date - INTERVAL '1' DAY, '%m')\n        AND day = date_format(current_date - INTERVAL '1' DAY, '%d'))\n    OR (year = date_format(current_date, '%Y')\n        AND month = date_format(current_date, '%m')\n        AND day = date_format(current_date, '%d')))\n  AND $__timeFilter(date_parse(window_end, '%Y-%m-%d %H:%i:%s'))\nGROUP BY DATE_TRUNC('minute', date_parse(window_end, '%Y-%m-%d %H:%i:%s'))\nORDER BY event_minute ASC",
          "refId": "A",
          "table": "silver_alerts"
        }
      ],
      "title": "Anomaly Detection Timeline (Flink 1분 버킷)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
