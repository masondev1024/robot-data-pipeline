          "datasource": { "type": "grafana-athena-datasource", "uid": "athena" },
          "format": 0,
          "rawSQL": "SELECT DATE_TRUNC('hour', from_iso8601_timestamp(\"timestamp\")) AS event_hour, COUNT(*) AS anomaly_count FROM robot_telemetry_db.bronze_robot_telemetry WHERE ((year = date_format(current_date - interval '1' day, '%Y') AND month = date_format(current_date - interval '1' day, '%m') AND day = date_format(current_date - interval '1' day, '%d')) OR (year = date_format(current_date, '%Y') AND month = date_format(current_date, '%m') AND day = date_format(current_date, '%d'))) AND motor_temp >= 92.0 AND motor_temp / GREATEST(current_load, 1.0) > 2.5 AND from_iso8601_timestamp(\"timestamp\") > current_timestamp - INTERVAL '24' HOUR GROUP BY DATE_TRUNC('hour', from_iso8601_timestamp(\"timestamp\")) ORDER BY event_hour ASC",
          "refId": "A",
          "table": "bronze_robot_telemetry"
        }
      ],
      "title": "Anomaly Detection Timeline (24h)",
      "type": "timeseries"
    }
