# PRISM 운영 콘솔 환경 변수 템플릿. 실제 사용 시 .env 로 복사 후 수정.
# cp .env.example .env

# ── 시연 결정론성 ────────────────────────────────────────────────────────
# demo = PYTHONHASHSEED=2026 강제 + 사전 녹화 timeline 사용
# dev  = 무작위 seed (개발자 탐색)
PRISM_MODE=demo

# ── Bedrock (Claude) 호출 설정 ───────────────────────────────────────────
BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
PRISM_SUPERVISOR_MODEL=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
PRISM_HAIKU_MODEL=apac.anthropic.claude-3-haiku-20240307-v1:0

# PRISM_OFFLINE=1 이면 assets/cache_replay.jsonl 만 사용. 네트워크/키 없이도 시연 가능.
# 본선·전시 부스 권장값. 기존 로컬 .env의 BEDROCK_OFFLINE=true도 허용되지만,
# 신규 배포는 반드시 PRISM_OFFLINE=1을 사용한다.
PRISM_OFFLINE=1

# live 모드는 장기 access key 대신 AWS Profile/SSO의 임시 자격증명을 사용.
AWS_PROFILE=robot-platform

# ── Streamlit 노출 포트 ─────────────────────────────────────────────────
DEMO_PORT=8501
LIVE_PORT=8502
OPERATOR_PORT=8503

# ── CNC generator tick 설정 ─────────────────────────────────────────────
# 1 tick = 1초. 100 = 100 tick 후 자동 일시정지 (시연용).
GENERATOR_TICK_LIMIT=0
GENERATOR_SEED=2026
