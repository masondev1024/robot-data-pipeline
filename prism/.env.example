# PRISM 운영 콘솔 환경 변수 템플릿. 실제 사용 시 .env 로 복사 후 수정.
# cp .env.example .env

# ── 시연 결정론성 ────────────────────────────────────────────────────────
# demo = PYTHONHASHSEED=2026 강제 + 사전 녹화 timeline 사용
# dev  = 무작위 seed (개발자 탐색)
PRISM_MODE=demo

# ── Bedrock (Claude) 호출 설정 ───────────────────────────────────────────
BEDROCK_REGION=us-west-2

# offline=true 면 assets/cache_replay.jsonl 만 사용. 네트워크/키 없이도 시연 가능.
# 본선·전시 부스 권장값.
BEDROCK_OFFLINE=true

# offline=false 일 때만 채울 것. offline=true 면 비워두면 됨.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Streamlit 노출 포트 ─────────────────────────────────────────────────
DEMO_PORT=8501
LIVE_PORT=8502
OPERATOR_PORT=8503

# ── CNC generator tick 설정 ─────────────────────────────────────────────
# 1 tick = 1초. 100 = 100 tick 후 자동 일시정지 (시연용).
GENERATOR_TICK_LIMIT=0
GENERATOR_SEED=2026
