# Copy these settings into a deployment-local file with mode 0600.
# PUBLIC_DOMAIN must be a bare public FQDN: no scheme, port, path, or whitespace.
# Generate the HTTP basic-auth bcrypt hash locally; do not commit it.
# Optional release image references belong only in the protected host file.
# PRISM_PUBLIC_OPERATOR_IMAGE=registry.example/prism-operator:<immutable-reference>
# PRISM_PUBLIC_CADDY_IMAGE=registry.example/prism-caddy:<immutable-reference>
PUBLIC_DOMAIN=
CADDY_ACME_EMAIL=
CADDY_BASIC_AUTH_USER=
# Docker Compose must receive this literal bcrypt form; retain the single quotes.
# CADDY_BASIC_AUTH_HASH='$2b$...'
